%% Architecture of fleetcast at commit 1c3ff5c86dd5048bb61f47082b78400005bcb3e5
%% Sources: fleetcast/__main__.py, fleetcast/data.py, fleetcast/features.py, fleetcast/model.py, app.py, demo.sh, tests/test_fleetcast.py, tests/test_app.py, .gitignore
%% Render: npx @mermaid-js/mermaid-cli -i docs/architecture.mmd -o docs/images/architecture.svg -b white
flowchart TD
    tlc["NYC TLC public files<br/>Jan + Feb 2025 Parquet,<br/>zone lookup"]

    subgraph prepsg["Offline: python -m fleetcast prepare"]
        direction LR
        prep["data.py: download,<br/>SHA-256, DuckDB<br/>30-min counts"]
        panel[("data/processed<br/>20-zone panel, provenance<br/>local, not committed")]
        prep --> panel
    end

    subgraph runsg["Offline: python -m fleetcast run"]
        direction LR
        feats["features.py<br/>past-only lags, rolling,<br/>calendar, zone"]
        gbt["Poisson gradient-boosted<br/>trees (scikit-learn<br/>HistGradientBoosting)"]
        score["Scoring (model.py)<br/>vs persistence and<br/>weekly-naive baselines"]
        feats -->|"fit, select on val,<br/>refit pre-test"| gbt
        gbt -->|"holdout forecasts"| score
        feats -->|"lag 1, lag 336"| score
    end

    art[("artifacts/first-run<br/>predictions, metrics,<br/>by-zone, by-day CSVs<br/>committed")]

    subgraph demo["Dashboard: demo.sh, Streamlit"]
        direction LR
        user(["Viewer picks<br/>zone, day, time"])
        app["app.py read-only<br/>holdout replay<br/>no model, no download"]
        user --> app
    end

    tests["pytest: leakage and<br/>metric checks, AppTest"]

    tlc -->|"download"| prepsg
    prepsg -->|"panel, hash check"| runsg
    runsg -->|"MAE RMSE WAPE bias"| art
    art -->|"reads"| demo
    tests -.-> runsg
    tests -.-> demo

    class tlc ext;
    class prep,feats,app det;
    class panel,art store;
    class gbt ai;
    class score,tests eval;
    class user human;

    classDef ai fill:#efe7fb,stroke:#6a4c93,stroke-width:2px,color:#2b1d45;
    classDef det fill:#eef3f8,stroke:#2f5d8a,stroke-width:1.5px,color:#172c37;
    classDef human fill:#e8f0ec,stroke:#285b48,stroke-width:1.5px,color:#173f32;
    classDef eval fill:#f7efdf,stroke:#8b6330,stroke-width:1.5px,color:#4a3413;
    classDef store fill:#f3f4f1,stroke:#65757b,stroke-width:1.5px,color:#172c37;
    classDef ext fill:#ffffff,stroke:#2f5d8a,stroke-width:1.5px,stroke-dasharray:4 3,color:#172c37;
    classDef mock fill:#ffffff,stroke:#9aa5a8,stroke-width:1.5px,stroke-dasharray:6 4,color:#65757b;
